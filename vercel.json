{
  "rewrites": [
    {
      "source": "/api/discord/:path*",
      "destination": "https://discord.com/api/v10/:path*"
    },
    {
      "source": "/api/telegram/:path*",
      "destination": "https://t.me/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
